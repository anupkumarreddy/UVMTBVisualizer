{
  "name": "uvm-testbench-visualizer",
  "productName": "UVM Testbench Visualizer",
  "version": "1.0.0",
  "description": "Interactive Electron visualizer for UVM print_topology() logs",
  "author": "Anup Reddy",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "build": "esbuild src/renderer.js --bundle --outfile=dist/renderer.js --format=iife --platform=browser --sourcemap",
    "start": "npm run build && electron .",
    "test": "node --test",
    "check": "npm test && npm run build"
  },
  "keywords": [
    "uvm",
    "systemverilog",
    "electron",
    "d3",
    "visualization"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anupkumarreddy/UVMTBVisualizer.git"
  },
  "bugs": {
    "url": "https://github.com/anupkumarreddy/UVMTBVisualizer/issues"
  },
  "homepage": "https://github.com/anupkumarreddy/UVMTBVisualizer#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "electron": "^43.5.0",
    "esbuild": "^0.28.1"
  }
}
